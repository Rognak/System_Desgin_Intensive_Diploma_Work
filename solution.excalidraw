    {
      "id": "F4ZxjtwkA9G3h6BKPb752",
      "type": "rectangle",
      "x": 314.89126553352946,
      "y": 2383.7888435156615,
      "width": 927.6190350229765,
      "height": 781.4770711203481,
      "angle": 0,
